{
  "worktree": {
    "setup": [
      "workz sync --isolated --quiet .",
      "scripts/lane-setup.sh"
    ],
    "teardown": ["scripts/lane-teardown.sh"]
  },
  "scripts": {
    "test": { "command": "pnpm test:unit" },
    "lint": { "command": "pnpm lint" },
    "gen:api": { "command": "pnpm gen:api" },
    "gen:api-local": { "command": "pnpm gen:api-local" },
    "runserver": { "type": "service", "command": "scripts/lane-web.sh fg" }
  }
}
