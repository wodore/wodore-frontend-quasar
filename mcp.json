{
  "mcpServers": {
    "playwright": {
      "type": "stdio",
      "command": "npx",
      "args": ["@playwright/mcp@latest --browser chromium"],
      "env": {}
    },
    "iconify": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "iconify-mcp-server@latest"],
      "env": {}
    },
    "penpot": {
      "type": "http",
      "url": "http://localhost:4401/mcp"
    }
  }
}
